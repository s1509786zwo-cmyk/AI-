# ─────────────────────────────────────────────────────────────
# AI審判の接続設定（サーバー側でのみ読み込まれます）
# ゲーム画面にAI設定はありません。ここ（.env.local）だけで完結します。
# ─────────────────────────────────────────────────────────────

# Google Gemini（推奨・既定）
AI_PROVIDER=gemini
GEMINI_API_KEY=...
AI_MODEL=gemini-2.5-flash
# 通常は未設定のまま。GeminiはネイティブAPI（/v1beta）を使用します。
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI / OpenAI互換API（OpenRouter, Groq, vLLM, LM Studio など）を使う場合
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1

# Anthropic を使う場合
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-5

# 推論品質を優先するモデル（審判・能力解析に使用。未指定なら AI_MODEL）
# AI_JUDGE_MODEL=gemini-2.5-flash
# 描写・行動選択に使う軽量モデル（未指定なら AI_MODEL）
# AI_FAST_MODEL=gemini-2.5-flash-lite
# ターン毎のAI出力の自己検証（推奨: on）
AI_AUDIT=on
# 1リクエストのタイムアウト（ミリ秒）
AI_TIMEOUT_MS=180000

# PostgreSQL（未設定の場合は .data/ 配下のファイルストアで永続化）
# DATABASE_URL=postgresql://user:pass@host:5432/db

